rule all:
	input:
		expand("mutation_freq_12repsim_{sim_num}.csv", sim_num=range(1,1001))
	conda:
		"workflow/envs/python-env.yaml"
	notebook:
		"workflow/notebooks/SLiM_sim_process.ipynb"

rule slim_sim:
	output: 
		temp("mutation_freq_12repsim_{sim_num}.csv")
	conda:
		"workflow/envs/slim-env.yaml"

	shell:
		"slim -d MU=7e-9 -d R=8.06452e-10 -d N=1500 -d S=0.95 -d sim_num={wildcards.sim_num} SLiM.for.snakemake" 	
