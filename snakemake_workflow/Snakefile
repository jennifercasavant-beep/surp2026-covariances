rule slim_sim:
	input: 
		"SLiM.for.snakemake"
	output: 
		[f"mutation_freq_12repsim_{sim_num}.csv" for sim_num in range(1..1000)] 
	conda:
		"slim"
	shell:
		"for sim_num in {1..1000}; do slim -d MU=7e-9 -d R=8.06452e-10 -d N=1500 -d S=0.95 -d sim_num=${sim_num} SLiM.for.snakemake; done"

rule all:
	input:
		[f"mutation_freq_12repsim_{sim_num}.csv" for sim_num in range(1,1001)]
	output:
		"simulated_conv_corr_snakeflow.csv"
	params:
		sim_id = lambda wildcards: wildcard.sim_num
	conda:
		"workflow/envs/python-env.yaml"
	notebook:
		"workflow/notebooks/SLiM.sim.process.ipynb"
	
